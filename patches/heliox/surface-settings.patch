+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #import=chrome://resources/cr_elements/cr_shared_style_lit.css.js
+ * #import=../settings_shared_lit.css.js
+ * #include=cr-shared-style-lit settings-shared-lit
+ * #css_wrapper_metadata_end */
+
+#surfaceStyle {
+  display: block;
+  padding: 8px calc(var(--cr-section-padding) - 12px);
+}
+
+.surface-option {
+  border-radius: var(--cr-card-border-radius);
+  flex: 1;
+  flex-direction: column;
+  gap: 8px;
+  min-width: 0;
+  padding: 12px 8px;
+}
+
+.surface-option:hover {
+  background-color: var(--cr-hover-background-color);
+}
+
+.surface-option::part(labelWrapper) {
+  align-self: stretch;
+  text-align: center;
+}
+
+.surface-option::part(disc) {
+  order: 1;
+}
+
+.surface-preview {
+  --preview-chrome-height: 34%;
+  aspect-ratio: 16 / 10;
+  background:
+      radial-gradient(circle at 18% 22%, #ff8a5c 0, transparent 46%),
+      radial-gradient(circle at 82% 16%, #5b8cff 0, transparent 52%),
+      radial-gradient(circle at 60% 88%, #b06bff 0, transparent 55%),
+      linear-gradient(135deg, #ffd27a, #3f51d8);
+  border: var(--cr-separator-line);
+  border-radius: 7px;
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  margin-bottom: 8px;
+  outline: 2px solid transparent;
+  overflow: hidden;
+  position: relative;
+}
+
+.surface-option[checked] .surface-preview {
+  outline-color: var(--cr-checked-color);
+}
+
+.preview-chrome {
+  align-items: center;
+  box-sizing: border-box;
+  display: flex;
+  flex: 0 0 var(--preview-chrome-height);
+  gap: 3px;
+  padding: 0 4px;
+}
+
+.preview-tab,
+.preview-field {
+  background-color: var(--cr-fallback-color-surface);
+  border-radius: 3px;
+  height: 46%;
+  opacity: .92;
+}
+
+.preview-tab {
+  flex: 0 0 26%;
+}
+
+.preview-field {
+  flex: 1;
+}
+
+.preview-content {
+  background-color: var(--cr-fallback-color-surface);
+  border-radius: 3px 3px 0 0;
+  flex: 1;
+  margin: 0 2px;
+}
+
+.solid .preview-chrome {
+  background-color: var(--cr-fallback-color-neutral-container);
+}
+
+.solid {
+  background: var(--cr-fallback-color-neutral-container);
+}
+
+.transparent .preview-chrome {
+  background-color: color-mix(
+      in srgb, var(--cr-fallback-color-neutral-container) 45%, transparent);
+}
+
+.liquid-glass .preview-chrome {
+  backdrop-filter: blur(5px) saturate(1.9) brightness(1.08);
+  background: linear-gradient(
+      180deg, rgba(255, 255, 255, .46), rgba(255, 255, 255, .12));
+  box-shadow:
+      inset 0 1px 0 rgba(255, 255, 255, .8),
+      inset 0 -1px 0 rgba(255, 255, 255, .22);
+}
+
+.blur .preview-chrome {
+  backdrop-filter: blur(4px);
+  background-color: color-mix(
+      in srgb, var(--cr-fallback-color-neutral-container) 30%, transparent);
+}
+
+.frosted-glass .preview-chrome {
+  backdrop-filter: blur(9px) saturate(1.2);
+  background-color: color-mix(
+      in srgb, var(--cr-fallback-color-surface) 62%, transparent);
+}
+
+.surface-description {
+  border-top: none;
+  min-height: 0;
+  padding-bottom: 8px;
+}
+
+settings-slider {
+  width: 240px;
+}

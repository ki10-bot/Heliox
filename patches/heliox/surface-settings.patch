+      <div class="flex cr-padded-text" aria-hidden="true">
+        $i18n{helioxSurfaceOpacity}
+      </div>
+      <settings-slider pref-key="heliox.surface.transparent.opacity"
+          min="5" max="100" label-aria="$i18n{helioxSurfaceOpacity}">
+      </settings-slider>
+    </div>
+  ` : ''}
+  ${this.isLiquidGlass_() ? html`
+    <div class="cr-row">
+      <div class="flex cr-padded-text" aria-hidden="true">
+        $i18n{helioxSurfaceVariant}
+      </div>
+      <settings-dropdown-menu label="$i18n{helioxSurfaceVariant}"
+          pref-key="heliox.surface.liquid_glass.variant"
+          .menuOptions="${this.glassVariantOptions_}">
+      </settings-dropdown-menu>
+    </div>
+    <div class="cr-row">
+      <div class="flex cr-padded-text" aria-hidden="true">
+        $i18n{helioxSurfaceTint}
+      </div>
+      <settings-slider pref-key="heliox.surface.liquid_glass.tint"
+          min="0" max="100" label-aria="$i18n{helioxSurfaceTint}">
+      </settings-slider>
+    </div>
+    <div class="cr-row">
+      <div class="flex cr-padded-text" aria-hidden="true">
+        $i18n{helioxSurfaceHighlight}
+      </div>
+      <settings-slider pref-key="heliox.surface.liquid_glass.highlight"
+          min="0" max="100" label-aria="$i18n{helioxSurfaceHighlight}">
+      </settings-slider>
+    </div>
+  ` : ''}
+  ${this.isBlur_() ? html`
+    <div class="cr-row">
+      <div class="flex cr-padded-text" aria-hidden="true">
+        $i18n{helioxSurfaceBlurRadius}
+      </div>
+      <settings-slider pref-key="heliox.surface.blur.radius"
+          min="0" max="100" label-aria="$i18n{helioxSurfaceBlurRadius}">
+      </settings-slider>
+    </div>
+    <div class="cr-row">
+      <div class="flex cr-padded-text" aria-hidden="true">
+        $i18n{helioxSurfaceTint}
+      </div>
+      <settings-slider pref-key="heliox.surface.blur.tint"
+          min="5" max="100" label-aria="$i18n{helioxSurfaceTint}">
+      </settings-slider>
+    </div>
+  ` : ''}
+  ${this.isFrostedGlass_() ? html`
+    <div class="cr-row">
+      <div class="flex cr-padded-text" aria-hidden="true">
+        $i18n{helioxSurfaceFrost}
+      </div>
+      <settings-slider pref-key="heliox.surface.frosted_glass.frost"
+          min="0" max="100" label-aria="$i18n{helioxSurfaceFrost}">
+      </settings-slider>
+    </div>
+    <div class="cr-row">
+      <div class="flex cr-padded-text" aria-hidden="true">
+        $i18n{helioxSurfaceTint}
+      </div>
+      <settings-slider pref-key="heliox.surface.frosted_glass.tint"
+          min="0" max="100" label-aria="$i18n{helioxSurfaceTint}">
+      </settings-slider>
+    </div>
+    <div class="cr-row">
+      <div class="flex cr-padded-text" aria-hidden="true">
+        $i18n{helioxSurfaceGrain}
+      </div>
+      <settings-slider pref-key="heliox.surface.frosted_glass.grain"
+          min="0" max="100" label-aria="$i18n{helioxSurfaceGrain}">

+  ` : ''}
+  ${this.isSolid_() ? '' : html`
+    <div class="cr-row">
+      <div class="flex cr-padded-text" aria-hidden="true">
+        $i18n{helioxSurfaceReset}
+      </div>
+      <cr-button id="resetSurface" @click="${this.onResetClick_}"

+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import '../controls/controlled_radio_button.js';
+import '../controls/settings_dropdown_menu.js';
+import '../controls/settings_radio_group.js';
+import '../controls/settings_slider.js';
+import '../settings_page/settings_section.js';
+
+import {PrefService} from '/shared/settings/prefs2/pref_service.js';
+import {PrefServiceObserverMixinLit} from '/shared/settings/prefs2/pref_service_observer_mixin_lit.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {DropdownMenuOptionList} from '../controls/settings_dropdown_menu.js';
+import {loadTimeData} from '../i18n_setup.js';
+
+import {getCss} from './appearance_surface_page.css.js';
+import {getHtml} from './appearance_surface_page.html.js';
+
+type PrefObject<T> = chrome.settingsPrivate.PrefObject<T>;
+
+enum SurfaceStyle {
+  SOLID = 0,
+  TRANSPARENT = 1,
+  LIQUID_GLASS = 2,
+  BLUR = 3,
+  FROSTED_GLASS = 4,
+}
+
+interface SurfaceStyleOption {
+  value: SurfaceStyle;
+  name: string;
+  description: string;
+  preview: string;
+}
+
+const SURFACE_DEFAULTS: Record<SurfaceStyle, Record<string, number>> = {
+  [SurfaceStyle.SOLID]: {},
+  [SurfaceStyle.TRANSPARENT]: {
+    'heliox.surface.transparent.opacity': 60,
+  },
+  [SurfaceStyle.LIQUID_GLASS]: {
+    'heliox.surface.liquid_glass.variant': 0,
+    'heliox.surface.liquid_glass.tint': 35,
+    'heliox.surface.liquid_glass.highlight': 30,
+  },
+  [SurfaceStyle.BLUR]: {
+    'heliox.surface.blur.radius': 50,
+    'heliox.surface.blur.tint': 40,
+  },
+  [SurfaceStyle.FROSTED_GLASS]: {
+    'heliox.surface.frosted_glass.frost': 45,
+    'heliox.surface.frosted_glass.tint': 30,
+    'heliox.surface.frosted_glass.grain': 30,
+  },
+};
+
+const SettingsAppearanceSurfacePageElementBase =
+    PrefServiceObserverMixinLit(CrLitElement);
+
+export class SettingsAppearanceSurfacePageElement extends
+    SettingsAppearanceSurfacePageElementBase {
+  static get is() {
+    return 'settings-appearance-surface-page';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      surfaceStylePref_: {type: Object},
+      surfaceStyleOptions_: {type: Array},
+      glassVariantOptions_: {type: Array},
+    };
+  }
+
+  protected accessor surfaceStylePref_: PrefObject<number>|undefined =
+      undefined;
+
+  protected accessor surfaceStyleOptions_: SurfaceStyleOption[] = [
+    {
+      value: SurfaceStyle.SOLID,
+      name: loadTimeData.getString('helioxSurfaceSolid'),
+      description: loadTimeData.getString('helioxSurfaceSolidDescription'),
+      preview: 'solid',
+    },
+    {
+      value: SurfaceStyle.TRANSPARENT,
+      name: loadTimeData.getString('helioxSurfaceTransparent'),
+      description:
+          loadTimeData.getString('helioxSurfaceTransparentDescription'),
+      preview: 'transparent',
+    },
+    {
+      value: SurfaceStyle.LIQUID_GLASS,
+      name: loadTimeData.getString('helioxSurfaceLiquidGlass'),
+      description:
+          loadTimeData.getString('helioxSurfaceLiquidGlassDescription'),
+      preview: 'liquid-glass',
+    },
+    {
+      value: SurfaceStyle.BLUR,
+      name: loadTimeData.getString('helioxSurfaceBlur'),
+      description: loadTimeData.getString('helioxSurfaceBlurDescription'),
+      preview: 'blur',
+    },
+    {
+      value: SurfaceStyle.FROSTED_GLASS,
+      name: loadTimeData.getString('helioxSurfaceFrostedGlass'),
+      description:
+          loadTimeData.getString('helioxSurfaceFrostedGlassDescription'),
+      preview: 'frosted-glass',
+    },
+  ];
+
+  protected accessor glassVariantOptions_: DropdownMenuOptionList = [
+    {value: 0, name: loadTimeData.getString('helioxSurfaceVariantRegular')},
+    {value: 1, name: loadTimeData.getString('helioxSurfaceVariantClear')},
+  ];
+
+  override connectedCallback() {
+    super.connectedCallback();
+
+    this.mirrorPrefs({
+      'heliox.surface.style': 'surfaceStylePref_',
+    });
+  }
+
+  protected isSolid_(): boolean {
+    return this.surfaceStylePref_?.value === SurfaceStyle.SOLID;
+  }
+
+  protected isTransparent_(): boolean {
+    return this.surfaceStylePref_?.value === SurfaceStyle.TRANSPARENT;
+  }
+
+  protected isLiquidGlass_(): boolean {
+    return this.surfaceStylePref_?.value === SurfaceStyle.LIQUID_GLASS;
+  }
+
+  protected isBlur_(): boolean {
+    return this.surfaceStylePref_?.value === SurfaceStyle.BLUR;
+  }
+
+  protected isFrostedGlass_(): boolean {
+    return this.surfaceStylePref_?.value === SurfaceStyle.FROSTED_GLASS;
+  }
+
+  protected getDescription_(): string {
+    const option = this.surfaceStyleOptions_.find(
+        item => item.value === this.surfaceStylePref_?.value);
+    return option ? option.description : '';
+  }
+
+  protected onResetClick_() {
+    const style = this.surfaceStylePref_?.value as SurfaceStyle | undefined;
+    if (style === undefined || !(style in SURFACE_DEFAULTS)) {
+      return;
+    }
+
+    for (const [key, value] of Object.entries(SURFACE_DEFAULTS[style])) {
+      PrefService.getInstance().setPrefValue(key, value);
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-appearance-surface-page': SettingsAppearanceSurfacePageElement;
+  }
+}
+
+customElements.define(
+    SettingsAppearanceSurfacePageElement.is,
+    SettingsAppearanceSurfacePageElement);

+#include "chrome/browser/ui/views/helium/heliox_surface.h"
+
+#include <algorithm>
+
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+
+namespace heliox {
+namespace {
+
+int GetPercent(const PrefService* prefs, const char* name) {
+  return std::clamp(prefs->GetInteger(name), 0, 100);
+}
+
+}
+
+const char* GetSurfaceStylePrefName() {
+  return prefs::kHelioxSurfaceStyle;
+}
+
+std::array<const char*, kSurfaceOptionPrefCount> GetSurfaceOptionPrefNames() {
+  return {
+      prefs::kHelioxTransparentOpacity,   prefs::kHelioxLiquidGlassVariant,
+      prefs::kHelioxLiquidGlassTint,      prefs::kHelioxLiquidGlassHighlight,
+      prefs::kHelioxBlurRadius,           prefs::kHelioxBlurTint,
+      prefs::kHelioxFrostedGlassFrost,    prefs::kHelioxFrostedGlassTint,
+      prefs::kHelioxFrostedGlassGrain,
+  };
+}
+
+SurfaceStyle GetSurfaceStyle(const PrefService* prefs) {
+  if (!prefs) {
+    return SurfaceStyle::kSolid;
+  }
+
+  switch (prefs->GetInteger(prefs::kHelioxSurfaceStyle)) {
+    case 1:
+      return SurfaceStyle::kTransparent;
+    case 2:
+      return SurfaceStyle::kLiquidGlass;
+    case 3:
+      return SurfaceStyle::kBlur;
+    case 4:
+      return SurfaceStyle::kFrostedGlass;
+    default:
+      return SurfaceStyle::kSolid;
+  }
+}
+
+SurfaceConfig GetSurfaceConfig(const PrefService* prefs) {
+  SurfaceConfig config;
+  if (!prefs) {
+    return config;
+  }
+
+  config.style = GetSurfaceStyle(prefs);
+  config.transparent_opacity =
+      GetPercent(prefs, prefs::kHelioxTransparentOpacity);
+  config.glass_variant =
+      prefs->GetInteger(prefs::kHelioxLiquidGlassVariant) == 1
+          ? GlassVariant::kClear
+          : GlassVariant::kRegular;
+  config.glass_tint = GetPercent(prefs, prefs::kHelioxLiquidGlassTint);
+  config.glass_highlight =
+      GetPercent(prefs, prefs::kHelioxLiquidGlassHighlight);
+  config.blur_radius = GetPercent(prefs, prefs::kHelioxBlurRadius);
+  config.blur_tint = GetPercent(prefs, prefs::kHelioxBlurTint);
+  config.frost = GetPercent(prefs, prefs::kHelioxFrostedGlassFrost);
+  config.frost_tint = GetPercent(prefs, prefs::kHelioxFrostedGlassTint);
+  config.frost_grain = GetPercent(prefs, prefs::kHelioxFrostedGlassGrain);
+  return config;
+}
+
+}
